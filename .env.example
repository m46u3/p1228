# Copy to .env. Never commit real bot tokens.
COMMUNITY_BOT_TOKEN=
COMMUNITY_BOT_TOKENS=
TTS_BOT_TOKEN=
TTS_BOT_TOKENS=
MINASE_BOT_TOKEN=
MINASE_BOT_TOKENS=
AI_BOT_TOKEN=
AI_BOT_TOKENS=
MUSIC_BOT_TOKEN=
MUSIC_BOT_TOKENS=
ENTERTAINMENT_BOT_TOKEN=
ENTERTAINMENT_BOT_TOKENS=
DEBUG_BOT_TOKEN=
DEBUG_BOT_TOKENS=

# Use a test guild for instant slash-command updates. Debug Bot requires this.
DISCORD_TEST_GUILD_ID=
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Tokyo
BOT_LOG_DIR=./logs

# Community auto-role: configure both role IDs to enable it.
COMMUNITY_MEMBER_ROLE_ID=
COMMUNITY_BOT_ROLE_ID=
COMMUNITY_AUTO_ROLE_BLACKLIST_USER_IDS=
COMMUNITY_ROLE_ALERT_CHANNEL_ID=

# TTS / VOICEVOX
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=1
TTS_MAX_TEXT_LENGTH=200
TTS_QUEUE_MAX_ITEMS=10

# AI / Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
AI_MAX_PROMPT_LENGTH=1000

# Music: direct, publicly reachable HTTPS audio URLs only.
MUSIC_QUEUE_LIMIT=20
MUSIC_MAX_BYTES=52428800

# Economy DBs are intentionally separated between the two bots.
MINASE_DATA_DIR=./data/minase
MINASE_DAILY_REWARD=100
ENTERTAINMENT_DATA_DIR=./data/entertainment
ENTERTAINMENT_START_BALANCE=100
ENTERTAINMENT_DAILY_REWARD=100
ENTERTAINMENT_LOTTERY_COST=50
